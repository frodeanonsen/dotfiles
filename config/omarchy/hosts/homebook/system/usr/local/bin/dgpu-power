#!/usr/bin/env bash
# Pins the discrete AMD GPU to its lowest clocks on battery and lets it scale
# freely on AC. On the 2018 MacBook Pro the Radeon Pro 560X drives the panel
# under Linux and cannot sleep; left in auto it idles at ~13 W and near its top
# clock on a bare desktop. Level "low" drops that to under 8 W.
#
# Run by the udev rule in /etc/udev/rules.d/99-dgpu-power.rules on every
# adapter plug/unplug and at boot. Also usable by hand:
#
#   dgpu-power            # follow the adapter state
#   dgpu-power battery    # force low clocks
#   dgpu-power ac         # force auto
#   dgpu-power status     # show what it is doing
set -eu

mode="${1:-auto}"

adapter_online() {
	local ac
	for ac in /sys/class/power_supply/*; do
		[ "$(cat "$ac/type" 2>/dev/null)" = "Mains" ] || continue
		[ "$(cat "$ac/online" 2>/dev/null)" = "1" ] && return 0
	done
	return 1
}

case "$mode" in
auto)
	if adapter_online; then level=auto; else level=low; fi
	;;
ac) level=auto ;;
battery) level=low ;;
status)
	for gpu in /sys/bus/pci/drivers/amdgpu/*/power_dpm_force_performance_level; do
		[ -e "$gpu" ] || continue
		dev=$(dirname "$gpu")
		printf '%s level=%s sclk=%s\n' "$(basename "$dev")" "$(cat "$gpu")" \
			"$(grep '\*' "$dev/pp_dpm_sclk" 2>/dev/null | awk '{print $2}')"
	done
	exit 0
	;;
*)
	echo "usage: dgpu-power [auto|ac|battery|status]" >&2
	exit 1
	;;
esac

for gpu in /sys/bus/pci/drivers/amdgpu/*/power_dpm_force_performance_level; do
	[ -e "$gpu" ] || continue
	echo "$level" >"$gpu"
done
