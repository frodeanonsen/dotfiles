#!/usr/bin/env bash

source "$CONFIG_DIR/environment"
source "$THEME_DIR/tokyonight"
SKETCHYBAR_BIN="${SKETCHYBAR_BIN:-/run/current-system/sw/bin/sketchybar}"
AEROSPACE_BIN="${AEROSPACE_BIN:-/opt/homebrew/bin/aerospace}"
STATE_DIR="${STATE_DIR:-$HOME/.cache/sketchybar}"
STATE_FILE="${STATE_FILE:-$STATE_DIR/aerospace-workspace-items}"

mkdir -p "$STATE_DIR"

cleanup_previous_items() {
	[ -f "$STATE_FILE" ] || return 0

	while IFS= read -r item_name; do
		[ -n "$item_name" ] || continue
		"$SKETCHYBAR_BIN" --remove "$item_name" >/dev/null 2>&1 || true
	done <"$STATE_FILE"
}

if [ "${1:-}" = "--cleanup" ]; then
	cleanup_previous_items
	rm -f "$STATE_FILE"
	exit 0
fi

create_workspace_bracket_for_monitor() {
	parameters=("$@")
	monitor_id=${parameters[0]}
	monitor_workspaces=("${parameters[@]:1}")
	bracket_members=()

	if [ $monitor_id -eq 1 ]; then
		"$SKETCHYBAR_BIN" --add item workspaces_spacer_left left \
			--set workspaces_spacer_left \
			width=4 \
			background.drawing=off \
			label.drawing=off
		created_items+=("workspaces_spacer_left")
	fi

	for workspace_id in ${monitor_workspaces[@]}; do
		item_name="workspaces.$monitor_id.$workspace_id"
		"$SKETCHYBAR_BIN" --add item "$item_name" left \
			--subscribe "$item_name" aerospace_workspace_change \
			--set "$item_name" \
			background.drawing=off \
			click_script="$AEROSPACE_BIN workspace $workspace_id" \
			label="$workspace_id" \
			label.width="25" \
			script="$PLUGIN_DIR/aerospace $workspace_id"
		bracket_members+=("$item_name")
		created_items+=("$item_name")
	done

	if [ $monitor_id -lt ${#monitor_ids[@]} ]; then
		separator_name="workspaces_monitor_separator.$monitor_id"
		"$SKETCHYBAR_BIN" --add item "$separator_name" left \
			--set "$separator_name" \
			background.drawing=off \
			label.padding_left=-6 \
			label.font.size="$BACKGROUND_HEIGHT" \
			label="|"
		bracket_members+=("$separator_name")
		created_items+=("$separator_name")
	else
		"$SKETCHYBAR_BIN" --add item workspaces_service_mode left \
			--subscribe workspaces_service_mode aerospace_service_mode_enabled_changed \
			--set workspaces_service_mode \
			background.drawing=off \
			label.drawing=off \
			label.highlight=on \
			label.font="$LABEL_HIGHLIGHT_FONT" \
			label="[s]" \
			label.padding_right=10 \
			script="$PLUGIN_DIR/aerospace $AEROSPACE_SERVICE_MODE_ENABLED"
		bracket_members+=("workspaces_service_mode")
		created_items+=("workspaces_service_mode")

		"$SKETCHYBAR_BIN" --add item workspaces_spacer_right left \
			--set workspaces_spacer_right \
			width=4 \
			background.drawing=off \
			label.drawing=off
		bracket_members+=("workspaces_spacer_right")
		created_items+=("workspaces_spacer_right")
	fi

	bracket_name="workspaces.$monitor_id"
	"$SKETCHYBAR_BIN" --add bracket "$bracket_name" "${bracket_members[@]}" \
		--set "$bracket_name" \
		background.padding_left="50" \
		background.corner_radius="$BRACKET_BACKGROUND_CORNER_RADIUS" \
		background.border_width="$BRACKET_BACKGROUND_BORDER_WIDTH"
	created_items+=("$bracket_name")
}

"$SKETCHYBAR_BIN" --add event aerospace_workspace_change
"$SKETCHYBAR_BIN" --add event aerospace_service_mode_enabled_changed

cleanup_previous_items
created_items=()
monitor_ids=($(sb_timeout "$SB_TIMEOUT_SECS" "$AEROSPACE_BIN" list-monitors | awk '{print $1}'))

# TODO:
# - Update this view when moving workspaces to a different monitors.
# - Only show workspaces with active windows or currently selected like in i3
#   default configuration.
for monitor_id in ${monitor_ids[@]}; do
	workspaces_for_monitor_id=($(sb_timeout "$SB_TIMEOUT_SECS" "$AEROSPACE_BIN" list-workspaces --monitor $monitor_id))
	create_workspace_bracket_for_monitor $monitor_id "${workspaces_for_monitor_id[@]}"
done

tmp_state_file="$(mktemp "${STATE_FILE}.XXXXXX")"
printf '%s\n' "${created_items[@]}" >"$tmp_state_file"
mv "$tmp_state_file" "$STATE_FILE"
