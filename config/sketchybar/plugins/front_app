#!/usr/bin/env bash

# Some events send additional information specific to the event in the $INFO
# variable. E.g. the front_app_switched event sends the name of the newly
# focused application in the $INFO variable:
# https://felixkratz.github.io/SketchyBar/config/events#events-and-scripting
SKETCHYBAR_BIN="${SKETCHYBAR_BIN:-/run/current-system/sw/bin/sketchybar}"

current_front_app() {
  /usr/bin/osascript -e 'tell application "System Events" to get name of first application process whose frontmost is true' 2>/dev/null
}

label="${INFO:-}"

if [ -z "$label" ]; then
  label="$(current_front_app)"
fi

if [ -n "$label" ] && [ -n "$NAME" ]; then
  "$SKETCHYBAR_BIN" --set "$NAME" label="$label"
fi
