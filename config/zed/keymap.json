[
  // Zoom
  {
    "context": "Workspace || Terminal || Editor",
    "bindings": {
      "ctrl-shift-m": "workspace::ToggleZoom",
    },
  },
  // Terminal
  {
    // Editor and Terminal are listed because the Linux default keymap binds
    // ctrl-/ to editor::ToggleComments, which would otherwise win over Workspace.
    "context": "Workspace || Terminal || Editor",
    "bindings": {
      "ctrl-/": "workspace::ToggleBottomDock",
    },
  },
  // Window's navigation
  {
    "context": "Dock || Terminal || Editor",
    "bindings": {
      // Window's motions
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
    },
  },
  {
    "context": "GitPanel",
    "bindings": {
      "q": "git_panel::Close",
    },
  },
  {
    "context": "AgentPanel && !Editor && !menu",
    "bindings": {
      "space a a": "workspace::CloseActiveDock",
    },
  },
  {
    "context": "AgentPanel > Editor && VimControl && !VimWaiting && !menu",
    "bindings": {
      "space a a": "workspace::CloseActiveDock",
    },
  },
  {
    "context": "AcpThread > Editor && VimControl && !VimWaiting && !menu",
    "bindings": {
      "space a a": "workspace::CloseActiveDock",
    },
  },
  {
    "context": "MessageEditor > Editor && VimControl && !VimWaiting && !menu",
    "bindings": {
      "space a a": "workspace::CloseActiveDock",
    },
  },
  {
    "context": "Editor && VimControl && !VimWaiting && !menu && !AgentPanel",
    "bindings": {
      "space a a": "agent::ToggleFocus",
    },
  },
  // File panel (netrw)
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "A": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      "d": "project_panel::Delete",
      "x": "project_panel::Cut",
      "c": "project_panel::Copy",
      "p": "project_panel::Paste",
      // Close the project panel, which is docked on the left
      "q": "workspace::ToggleLeftDock",
      "space e": "workspace::ToggleLeftDock",
      "space E": "workspace::ToggleLeftDock",
      ":": "command_palette::Toggle",
      "%": "project_panel::NewFile",
      "/": "project_panel::NewSearchInDirectory",
      "enter": "project_panel::OpenPermanent",
      "escape": "project_panel::ToggleFocus",
      "h": "project_panel::CollapseSelectedEntry",
      "j": "menu::SelectNext",
      "k": "menu::SelectPrevious",
      "l": "project_panel::ExpandSelectedEntry",
      "o": "project_panel::OpenPermanent",
      "t": "project_panel::OpenPermanent",
      "v": "project_panel::OpenPermanent",
      "shift-g": "menu::SelectLast",
      "g g": "menu::SelectFirst",
      "-": "project_panel::SelectParent",
      "ctrl-6": "pane::AlternateFile",
      "shift-i": "project_panel::ToggleHideGitIgnore",
      "shift-h": "project_panel::ToggleHideHidden",
    },
  },
  // Empty pane, set of keybindings that are available when there is no active editor
  {
    "context": "EmptyPane || SharedScreen",
    "bindings": {
      // Open file finder
      "space space": "file_finder::Toggle",
      "space f f": "file_finder::Toggle",
      "space ,": "tab_switcher::Toggle",
      // File explorer
      "space e": "project_panel::ToggleFocus",
      // New file
      "space f n": "workspace::NewFile",
      // Open recent project
      "space f p": "projects::OpenRecent",
      // Search in all the files
      "space s g": "workspace::NewSearch",
      // Lazygit
      "space g g": [
        "task::Spawn",
        {
          "task_name": "start lazygit",
          "reveal_target": "center",
        },
      ],
      // Quit zed
      "space q q": "zed::Quit",
    },
  },
  {
    "context": "Editor && VimControl && !VimWaiting && !menu",
    "bindings": {
      // Refactoring
      "space c r": "editor::Rename",
      // Chat with AI
      "space a e": "assistant::InlineAssist",
      // Git
      "space g g": [
        "task::Spawn",
        {
          "task_name": "start lazygit",
          "reveal_target": "center",
        },
      ],
      "space g f": [
        "task::Spawn",
        {
          "task_name": "start lazygit file log",
          "reveal_target": "center",
        },
      ],
      "space g s": "git_panel::ToggleFocus",
      "space g b": "git::Blame",
      "space g B": "editor::OpenPermalinkToLine",
      "space g h s": "git::ToggleStaged",
      "space g h S": "git::StageFile",
      "space g h p": "editor::ToggleSelectedDiffHunks",
      "space g h b": "git::Blame",
      "space g h d": "editor::ExpandAllDiffHunks",
      "space g h D": "git::Diff",
      "space g h r": "git::Restore",
      "space g h R": "git::RestoreFile",
      // UI toggles
      "space u h": "editor::ToggleInlayHints",
      "space u w": "editor::ToggleSoftWrap",
      "space u l": "editor::ToggleLineNumbers",
      "space u L": "editor::ToggleRelativeLineNumbers",
      "space u g": "editor::ToggleIndentGuides",
      "space u d": "editor::ToggleDiagnostics",
      "space u z": "workspace::ToggleCenteredLayout",
      "space u Z": "workspace::ToggleZoom",
      "space u C": "theme_selector::Toggle",
      // Open markdown preview
      "space c p": "markdown::OpenPreview",
      "space c P": "markdown::OpenPreviewToTheSide",
      // Search word under cursor in all the files
      "space s w": "pane::DeploySearch",
      "space s W": "pane::DeploySearch",
      // Search and replace in all the files
      "space s r": ["pane::DeploySearch", { "replace_enabled": true }],
      // Tab things. Almost as good as harpoon.
      "space 1": ["pane::ActivateItem", 0],
      "space 2": ["pane::ActivateItem", 1],
      "space 3": ["pane::ActivateItem", 2],
      "space 4": ["pane::ActivateItem", 3],
      "space 5": ["pane::ActivateItem", 4],
      "space 6": ["pane::ActivateItem", 5],
      "space 7": ["pane::ActivateItem", 6],
      "space 8": ["pane::ActivateItem", 7],
      "space 9": ["pane::ActivateItem", 8],
      "space 0": "pane::ActivateLastItem",
      "] b": "pane::ActivateNextItem",
      "[ b": "pane::ActivatePreviousItem",
      "space ,": "tab_switcher::Toggle",
      "space f b": "tab_switcher::Toggle",
      // Jump to the previous location
      "space b b": "pane::AlternateFile",
      "space `": "pane::AlternateFile",
      // Close buffer
      "space b d": "pane::CloseActiveItem",
      // Close inactive buffers
      "space b o": "pane::CloseOtherItems",
      "space b r": "pane::CloseItemsToTheRight",
      "space b l": "pane::CloseItemsToTheLeft",
      // Pin buffer
      "space b p": "pane::TogglePinTab",
      // New file
      "space b n": "workspace::NewFile",
      // Search in the current buffer
      "space s b": "buffer_search::Deploy",
      // Search in all the files
      "space s g": "workspace::NewSearch",
      // Search
      "space /": "workspace::NewSearch",
      // Keymaps, commands
      "space s k": "zed::OpenKeymap",
      "space s C": "command_palette::Toggle",
      // LSP & Code actions
      "space c a": "editor::ToggleCodeActions",
      "space c s": "outline_panel::ToggleFocus",
      "space s s": "outline::Toggle",
      "space s S": "project_symbols::Toggle",
      // Diagnostics
      "space s d": "diagnostics::Deploy",
      "space x x": "diagnostics::Deploy",
      "space x X": "diagnostics::DeployCurrentFile",
      // Format
      "space c f": "editor::Format",
      // File explorer
      "space e": "project_panel::ToggleFocus",
      "space E": "project_panel::ToggleFocus",
      "space f e": "project_panel::ToggleFocus",
      "space f E": "project_panel::ToggleFocus",
      "space space": "file_finder::Toggle",
      // Quit zed
      "space q q": "zed::Quit",
      // Terminal
      "space f t": "workspace::ToggleBottomDock",
      // Windows management
      "space w s": "pane::SplitDown",
      "space w v": "pane::SplitRight",
      "space -": "pane::SplitDown",
      "space |": "pane::SplitRight",
      "space w c": "pane::CloseAllItems",
      "space w d": "pane::CloseAllItems",
      "space w m": "workspace::ToggleZoom",

      // Files
      "space f f": "file_finder::Toggle",
      "space f n": "workspace::NewFile",
      "space f p": "projects::OpenRecent",
      "space f c": "zed::OpenSettingsFile",
      "space f k": "zed::OpenKeymapFile",

      // Jump to hunks
      "] h": "editor::GoToHunk",
      "[ h": "editor::GoToPreviousHunk",
      "] c": "editor::GoToHunk",
      "[ c": "editor::GoToPreviousHunk",
      // Jump to diagnostic, error, warning
      "] d": "editor::GoToDiagnostic",
      "[ d": "editor::GoToPreviousDiagnostic",
      "] e": ["editor::GoToDiagnostic", { "severity": { "min": "error", "max": "error" } }],
      "[ e": ["editor::GoToPreviousDiagnostic", { "severity": { "min": "error", "max": "error" } }],
      "] w": ["editor::GoToDiagnostic", { "severity": { "min": "warning", "max": "warning" } }],
      "[ w": ["editor::GoToPreviousDiagnostic", { "severity": { "min": "warning", "max": "warning" } }],
      // Excerpts
      "] q": "editor::MoveToStartOfNextExcerpt",
      "[ q": "editor::MoveToStartOfExcerpt",

      // Build and run
      "space r t": "task::Spawn",
      "space r b": [
        "task::Spawn",
        {
          "task_name": "build",
          "reveal_target": "dock",
        },
      ],
      "space r w": [
        "task::Spawn",
        {
          "task_name": "watch",
          "reveal_target": "dock",
        },
      ],
      "space r c": [
        "task::Spawn",
        {
          "task_name": "bacon",
          "reveal_target": "dock",
        },
      ],
      // Run nearest, run last
      "space t r": "editor::SpawnNearestTask",
      "space t l": "task::Rerun",
    },
  },
  {
    // Not while an edit prediction is shown, where alt-j/alt-k accept parts of it
    "context": "Editor && (vim_mode == normal || vim_mode == insert || vim_mode == visual) && !edit_prediction",
    "bindings": {
      // Line's Motions
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp",
    },
  },
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual) && !VimWaiting && !menu",
    "bindings": {
      // Incremental selection
      "ctrl-space": "editor::SelectLargerSyntaxNode",
      "backspace": "editor::SelectSmallerSyntaxNode",
    },
  },
  // Center the cursor on the screen when scrolling and find all references
  {
    "context": "VimControl && !menu",
    "bindings": {
      "ctrl-d": ["workspace::SendKeystrokes", "ctrl-d z z"],
      "ctrl-u": ["workspace::SendKeystrokes", "ctrl-u z z"],
      "n": ["workspace::SendKeystrokes", "n z z z v"],
      "shift-n": ["workspace::SendKeystrokes", "shift-n z z z v"],
      "shift-g": ["workspace::SendKeystrokes", "shift-g z z"],
      "g r": "editor::FindAllReferences",
      // The default g r <key> bindings would make g r wait for the key timeout
      "g r n": null,
      "g r r": null,
      "g r a": null,
      "g r i": null,
      "g shift-k": "editor::ShowSignatureHelp",
    },
  },
  {
    "context": "vim_operator == d",
    "bindings": {
      "o": "editor::ExpandAllDiffHunks",
      "r": "git::Restore",
    },
  },
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      "s": "vim::PushSneak",
      "S": "vim::PushSneakBackward",
    },
  },
  {
    "context": "vim_operator == a || vim_operator == i || vim_operator == cs",
    "bindings": {
      "b": "vim::AnyBrackets",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-s": "workspace::Save",
      // On Linux, Hyprland passes Super+C/V/X through to Zed (hypr/bindings.lua)
      // and Zed reads Super as cmd, so these match the macOS defaults.
      "cmd-c": "editor::Copy",
      "cmd-v": "editor::Paste",
      "cmd-x": "editor::Cut",
    },
  },
  {
    "context": "VimControl || !Editor",
    "bindings": {
      "ctrl-shift-k": "vim::ResizePaneUp",
      "ctrl-shift-j": "vim::ResizePaneDown",
      "ctrl-shift-h": "vim::ResizePaneLeft",
      "ctrl-shift-l": "vim::ResizePaneRight",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-a ctrl-l": ["terminal::SendKeystroke", "ctrl-l"],
      "cmd-v": "terminal::Paste",
      "cmd-c": "terminal::Copy",
    },
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "shift-l": "vim::GoToTab",
      "shift-h": "vim::GoToPreviousTab",
    },
  },
  {
    "bindings": {
      "cmd-q": null,
    },
  },
  {
    "context": "(VimControl && !menu)",
    "bindings": {
      "space": null, // Disable the default action vim::WrappingRight
    },
  },
]
