// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "buffer_font_weight": 300.0,
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "edit_predictions": {
    "provider": "zed",
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true,
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "effort": "medium",
        "model": "opus[1m]",
        "mode": "acceptEdits"
      },
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry",
      "default_config_options": {
        "model": "gpt-5.4",
        "mode": "full-access",
      },
    },
    "github-copilot-cli": {
      "default_config_options": {
        "mode": "https://agentclientprotocol.com/protocol/session-modes#agent",
        "reasoning_effort": "high",
        "model": "gpt-5.6-sol",
        "allow_all": "on",
      },
      "type": "registry",
    },
  },
  "which_key": {
    "enabled": true,
    "delay_ms": 100,
  },
  "colorize_brackets": true,
  "base_keymap": "VSCode",
  "git": {
    "inline_blame": {
      "enabled": false,
    },
    "worktree_directory": "worktrees",
  },
  "project_panel": {
    "dock": "left",
    "hide_hidden": false,
    "hide_gitignore": false,
  },
  "load_direnv": "direct",
  "ssh_connections": [
    {
      "host": "zygizo-two",
